<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="robots" content="noindex"/>
<title>Verify your email | KMVTECH Education</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#0D1B2A;--gold:#C9922A;--blue:#2B3FBF;--purple:#6B2ECC;--green:#15803D;--red:#DC2626;--gray:#6B7280;--dark:#1C1C1C;--surface:#fff;--bg:#FAF9F6;--border:#E5E7EB;--light:#EEF0FF}
[data-theme="dark"]{--dark:#F9FAFB;--bg:#0F172A;--surface:#1E293B;--border:#334155;--light:#1E2D40;--gray:#9CA3AF}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--dark);min-height:100vh;line-height:1.6}
nav{background:var(--navy);padding:.8rem 1.2rem;border-bottom:2px solid var(--gold)}
.logo{font-family:'Playfair Display',serif;font-weight:900;color:#fff;font-size:1.1rem;text-decoration:none}
.logo span{color:var(--gold)}
.page{max-width:480px;margin:0 auto;padding:2rem 1.2rem 3rem}
.card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2rem 1.5rem;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,.06)}
.icon{width:76px;height:76px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.1rem;font-size:2.2rem;background:var(--light)}
.icon.ok{background:#DCFCE7}.icon.warn{background:#FEF3C7}
h1{font-family:'Playfair Display',serif;font-size:1.55rem;color:var(--navy);margin-bottom:.5rem}
[data-theme="dark"] h1{color:#F8FAFC}
p{font-size:.95rem;color:var(--gray);margin-bottom:1rem}
.num{display:inline-block;background:var(--light);color:var(--blue);font-weight:700;padding:.45rem 1rem;border-radius:20px;margin:.2rem 0 1rem;font-size:.95rem}
[data-theme="dark"] .num{color:#93C5FD}
.btn{display:block;width:100%;padding:.9rem 1.1rem;border-radius:10px;font-size:1rem;font-weight:700;text-decoration:none;text-align:center;border:0;cursor:pointer;font-family:inherit;margin-top:.6rem}
.btn.primary{background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff}
.btn.ghost{background:transparent;color:var(--blue);border:2px solid var(--blue)}
.btn:disabled{opacity:.6;cursor:not-allowed}
input{width:100%;padding:.8rem .9rem;border:1.5px solid var(--border);border-radius:8px;font-size:1rem;font-family:inherit;background:var(--surface);color:var(--dark);margin:.2rem 0 .4rem}
input:focus{outline:none;border-color:var(--blue)}
.msg{font-size:.88rem;margin:.5rem 0;padding:.6rem .8rem;border-radius:8px;text-align:left}
.msg.good{background:#F0FDF4;color:#166534}.msg.bad{background:#FEF2F2;color:#991B1B}
.small{font-size:.8rem;color:var(--gray);margin-top:.8rem}
.help{margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--border);font-size:.85rem;color:var(--gray)}
.help a{color:var(--blue);font-weight:600;text-decoration:none}
.spin{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:s .7s linear infinite;margin:0 auto 1rem}
@keyframes s{to{transform:rotate(360deg)}}
</style>
</head>
<body>
<nav><a class="logo" href="/education/"><span>KMVTECH</span> Education</a></nav>
<div class="page"><div class="card" id="app" aria-live="polite"><div class="spin"></div><h1>Checking your link...</h1><p>One moment please.</p></div></div>
<script>
(function(){var t=localStorage.getItem('kmv-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();
var SB = supabase.createClient('https://nzjojrebyvxuawnkitth.supabase.co','sb_publishable_EKcJxtkPvorUeuLB9Q2xLA_SYIWzDDa');
var APP = document.getElementById('app');
var go = function(u){ (window.__navigate || function(x){ window.location.assign(x); })(u); };
var hp = new URLSearchParams((location.hash || '').replace(/^#/, ''));
var sp = new URLSearchParams(location.search || '');
function get(k){ return hp.get(k) || sp.get(k); }
var errCode = get('error_code') || get('error');
var type = get('type');
function safeReturn(v){ if(!v) return null; try{ var u=new URL(v, location.origin); if(u.origin!==location.origin||u.pathname.indexOf('/education/')!==0) return null; if(/\/(login|register|verified)\/?$/.test(u.pathname)) return null; return u.pathname+u.search+u.hash; }catch(e){ return null; } }
var ret = safeReturn(sp.get('return'));
var after = ret || '/education/dashboard/';
function verifyUrl(){ return location.origin + '/education/verified/' + (ret ? '?return=' + encodeURIComponent(ret) : ''); }
var fromLink = !!(get('access_token') || get('code') || get('token_hash') || type === 'signup' || errCode);
var HELP = '<div class="help">Need help? WhatsApp <a href="https://wa.me/256759405181">+256 759 405 181</a> or email <a href="mailto:kmvtechug@gmail.com">kmvtechug@gmail.com</a></div>';
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function withTimeout(p,ms){return Promise.race([p,new Promise(function(_,r){setTimeout(function(){r(new Error('timeout'));},ms);})]);}
function cleanUrl(){try{history.replaceState(null,'',location.pathname);}catch(e){}}

function showVerified(name, number){
  var first = name ? esc(String(name).split(' ')[0]) : '';
  APP.innerHTML = '<div class="icon ok">&#9989;</div><h1>Email verified</h1>'
    + '<p>' + (first ? 'Welcome, <strong>' + first + '</strong>. ' : '') + 'Your account is ready.</p>'
    + (number ? '<div>Your student number</div><div class="num">' + esc(number) + '</div><p class="small" style="margin-top:0">Keep it safe. You will need it when you enroll.</p>' : '')
    + '<a class="btn primary" href="' + esc(after) + '">' + (ret ? 'Continue where you stopped' : 'Go to my dashboard') + '</a>'
    + '<p class="small" id="count">' + (ret ? 'Taking you back in' : 'Opening your dashboard in') + ' <span id="n">6</span> seconds...</p>' + HELP;
  var n = 6, iv = setInterval(function(){ n--; var el = document.getElementById('n'); if(el) el.textContent = n; if(n <= 0){ clearInterval(iv); go(after); } }, 1000);
}
function showVerifiedLogin(){
  APP.innerHTML = '<div class="icon ok">&#9989;</div><h1>Your email is verified</h1>'
    + '<p>Thank you. Log in with your email and password to continue.</p>'
    + '<a class="btn primary" href="/education/login/?verified=1' + (ret ? '&return=' + encodeURIComponent(ret) : '') + '">Tap here to log in</a>' + HELP;
}
function showNeutral(){
  APP.innerHTML = '<div class="icon">&#128231;</div><h1>Check your inbox</h1>'
    + '<p>Open the email we sent you and tap the <strong>Verify</strong> button. If you cannot find it, look in your spam or junk folder.</p>'
    + '<a class="btn primary" href="/education/login/">I have verified, log in</a>'
    + '<a class="btn ghost" href="/education/register/">Register a new account</a>' + HELP;
}
function showExpired(){
  APP.innerHTML = '<div class="icon warn">&#9888;&#65039;</div><h1>This link has expired</h1>'
    + '<p>Verification links work once and expire after a while. If you already verified your email, just log in. If not, we can send you a new link.</p>'
    + '<a class="btn primary" href="/education/login/">I already verified, log in</a>'
    + '<p class="small" style="margin-top:1.2rem">Need a new link? Enter your email:</p>'
    + '<input type="email" id="em" placeholder="you@example.com" autocomplete="email" aria-label="Your email"/>'
    + '<div id="out"></div><button class="btn ghost" id="rs">Send me a new link</button>' + HELP;
  document.getElementById('rs').onclick = resend;
}
async function resend(){
  var em = document.getElementById('em').value.trim(), out = document.getElementById('out'), b = document.getElementById('rs');
  if(!/^\S+@\S+\.\S+$/.test(em)){ out.innerHTML = '<div class="msg bad">Please enter a valid email address.</div>'; return; }
  b.disabled = true; b.textContent = 'Sending...'; out.innerHTML = '';
  try{
    var r = await withTimeout(SB.auth.resend({type:'signup', email:em, options:{emailRedirectTo: verifyUrl()}}), 12000);
    if(r.error) throw r.error;
    out.innerHTML = '<div class="msg good">Done. Check your inbox (and spam folder) for the new link.</div>'; b.textContent = 'Sent';
  }catch(e){
    var m = String(e && e.message || '');
    var friendly = /seconds|rate|too many/i.test(m) ? 'Please wait a minute before asking for another email.' : 'We could not send the email right now. Please WhatsApp us and we will help you.';
    out.innerHTML = '<div class="msg bad">' + esc(friendly) + '</div>'; b.disabled = false; b.textContent = 'Send me a new link';
  }
}
async function init(){
  if(type === 'recovery'){ go('/education/auth-error/' + location.search + location.hash); return; }
  if(errCode){ cleanUrl(); showExpired(); return; }
  try{
    var s = await withTimeout(SB.auth.getSession(), 8000), session = s && s.data && s.data.session;
    cleanUrl();
    if(session){
      var name = '', num = '';
      try{ var p = await withTimeout(SB.from('profiles').select('full_name,student_number').eq('id', session.user.id).maybeSingle(), 4000); if(p && p.data){ name = p.data.full_name; num = p.data.student_number; } }catch(e){}
      showVerified(name, num); return;
    }
    if(fromLink) showVerifiedLogin(); else showNeutral();
  }catch(e){ if(fromLink) showVerifiedLogin(); else showNeutral(); }
}
init();
</script>
</body>
</html>
